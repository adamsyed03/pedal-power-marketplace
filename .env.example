# Banca Intesa / NestPay 3D Pay Hosting (server-only; never expose via VITE_*).
# StoreKey may contain characters .env parsers treat specially — keep it quoted.
# Pair test with test.ridepogon.com + testsecurepay, and production with
# ridepogon.com + bib.eway2pay.com. The application rejects mixed pairs.
NESTPAY_ENV=test
NESTPAY_MERCHANT_ID=13IN004634
NESTPAY_STORE_KEY=""
# Optional: used only by protected secondary Order Status operations.
NESTPAY_API_USERNAME=
NESTPAY_API_PASSWORD=
NESTPAY_3D_URL=https://testsecurepay.eway2pay.com/fim/est3Dgate
NESTPAY_API_URL=https://testsecurepay.eway2pay.com/fim/api

