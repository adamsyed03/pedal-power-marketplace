SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
MERCHANT_LEGAL_NAME=Pogon Mobility d.o.o.
MERCHANT_PIB=115472260
MERCHANT_ADDRESS=Temišvarska 25B, Beograd
