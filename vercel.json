{
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "routes": [
    { "src": "/(.*)", "has": [{ "type": "host", "value": "www.ridepogon.com" }], "headers": { "Location": "https://ridepogon.com/$1" }, "status": 308 },
    { "src": "^/(elektricni-bicikli|electric-bikes|oprema|vodici|o-nama|partneri|kontakt|dostava)$", "headers": { "Location": "/$1/" }, "status": 308 },
    { "src": "^/products/(core|cargo|glide)$", "headers": { "Location": "/products/$1/" }, "status": 308 },
    { "src": "^/uk/products/(core|cargo|glide|fold)$", "headers": { "Location": "/uk/products/$1/" }, "status": 308 },
    { "src": "^/admin/$", "headers": { "Location": "/admin" }, "status": 308 },
    { "src": "^/elektricni-bicikli/(core|cargo|glide)/?$", "headers": { "Location": "/products/$1/" }, "status": 308 },
    { "src": "^/(elektricni-bicikli/(?:beograd|novi-sad|nis|kragujevac)|vodici/[^./]+)$", "headers": { "Location": "/$1/" }, "status": 308 },
    { "src": "/assets/(.*)", "headers": { "Cache-Control": "public, max-age=31536000, immutable" }, "continue": true },
    { "src": "/(.*)\\.(jpg|jpeg|png|svg|webp|avif)", "headers": { "Cache-Control": "public, max-age=2592000, stale-while-revalidate=86400" }, "continue": true },
    { "src": "/checkout/?", "headers": { "X-Robots-Tag": "noindex, nofollow, noarchive" }, "continue": true },
    { "src": "^/admin$", "headers": { "X-Robots-Tag": "noindex, nofollow, noarchive" }, "continue": true },
    { "src": "/payment/(.*)", "headers": { "X-Robots-Tag": "noindex, nofollow, noarchive" }, "continue": true },
    { "src": "/api/(.*)", "headers": { "X-Robots-Tag": "noindex, nofollow, noarchive" }, "continue": true },
    { "src": "^/(1|uk/1)/?$", "headers": { "X-Robots-Tag": "noindex, nofollow, noarchive" }, "continue": true },
    { "src": "^/oprema/$", "dest": "/oprema/index.html" },
    { "src": "^/(o-nama|dostava|electric-bikes)/$", "dest": "/$1/index.html" },
    { "src": "^/elektricni-bicikli/$", "dest": "/elektricni-bicikli/index.html" },
    { "src": "^/products/(core|cargo|glide)/$", "dest": "/products/$1/index.html" },
    { "src": "^/elektricni-bicikli/(beograd|novi-sad|nis|kragujevac)/$", "dest": "/elektricni-bicikli/$1/index.html" },
    { "src": "^/vodici/$", "dest": "/vodici/index.html" },
    { "src": "^/vodici/([^/]+)/$", "dest": "/vodici/$1/index.html" },
    { "src": "^/(admin|checkout|kviz|partneri|kontakt|uslovi-kupovine|informacije-o-trgovcu|dostava|reklamacije|povracaj-sredstava|privatnost|bezbednost-placanja|payment/card|payment/success|payment/failed|uk|1|uk/1)/?$", "dest": "/index.html" },
    { "src": "^/uk/products/(core|cargo|glide|fold)/$", "dest": "/index.html" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "status": 404, "dest": "/404.html" }
  ]
}
